{
  "name": "Custom-Ollama-Workspace",
  "description": "Custom Ollama Workspace",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "agent": "npm run dev --workspace=@lzimul/agent",
    "ai": "npm run dev --workspace=@lzimul/ai",
    "mcp": "npm run dev --workspace=@lzimul/mcp",
    "ollama": "npm run dev --workspace=@lzimul/ollama",
    "dev": "npm run all",
    "all": "concurrently -n AI,MCP,Ollama -c cyan,magenta,green -p name \"npm run ai\" \"npm run mcp\" \"npm run ollama\"",
    "test": "echo Done"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "workspaces": [
    "AI",
    "MCP",
    "Ollama"
  ],
  "private": true
}
